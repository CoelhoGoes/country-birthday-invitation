# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: NUNCA expor ao client. Usada apenas em Route Handlers
# server-side (app/api/**), nunca em componentes client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Senha única para acessar a área /admin e a exportação (/api/export).
ADMIN_PASSWORD=
